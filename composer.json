{
    "name": "tomatophp/filament-bookmarks-menu",
    "type": "library",
    "description": "Add bookmarks and tags to your resources records and access theme form your sidebar",
    "keywords": [
        "php",
        "laravel",
        "filament",
        "filamentphp",
        "bookmarks",
        "sidebar",
        "menu"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TomatoPHP\\FilamentBookmarksMenu\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TomatoPHP\\FilamentBookmarksMenu\\Tests\\": "tests/src",
            "TomatoPHP\\FilamentBookmarksMenu\\Tests\\Database\\Factories\\": "tests/database/factories"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TomatoPHP\\FilamentBookmarksMenu\\FilamentBookmarksMenuServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Fady Mondy",
            "email": "info@3x1.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "tomatophp/console-helpers": "^1.1",
        "filament/filament": "^5.0",
        "tomatophp/filament-icons": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "pestphp/pest-plugin-livewire": "^4.0|^5.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse src",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "version": "5.0.0"
}
